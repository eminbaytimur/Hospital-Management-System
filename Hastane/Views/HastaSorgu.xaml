<UserControl x:Class="Hastane.Views.HastaSorgu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Hastane.Views"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="1200">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="auto" />
        </Grid.ColumnDefinitions>
        
        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="5">
            <TextBox x:Name="txtKimlikNo" MaxLength="11" Width="100" materialDesign:TextFieldAssist.CharacterCounterVisibility="Hidden" PreviewTextInput="txtKimlikNo_PreviewTextInput" materialDesign:HintAssist.Hint="Kimlik No" Margin="{StaticResource FilterElementMargin}" Padding="{StaticResource FilterElementPadding}" />
            <TextBox x:Name="txtAd" MaxLength="50" Width="150" materialDesign:TextFieldAssist.CharacterCounterVisibility="Hidden" materialDesign:HintAssist.Hint="Ad" Margin="{StaticResource FilterElementMargin}" Padding="{StaticResource FilterElementPadding}" />
            <TextBox x:Name="txtSoyad" MaxLength="50" Width="150" materialDesign:TextFieldAssist.CharacterCounterVisibility="Hidden" materialDesign:HintAssist.Hint="Soyad" Margin="{StaticResource FilterElementMargin}" Padding="{StaticResource FilterElementPadding}" />
            <ComboBox x:Name="cmbCinsiyet" Width="80" materialDesign:HintAssist.Hint="Cinsiyet" Margin="{StaticResource FilterElementMargin}" Padding="{StaticResource FilterComboPadding}" />
            <TextBox x:Name="txtTelefon" MaxLength="12" Width="100" materialDesign:TextFieldAssist.CharacterCounterVisibility="Hidden" materialDesign:HintAssist.Hint="Telefon" TextChanged="txtTelefon_TextChanged" Margin="{StaticResource FilterElementMargin}" Padding="{StaticResource FilterElementPadding}" />
            <TextBox x:Name="txtEposta" MaxLength="100" Width="180" materialDesign:TextFieldAssist.CharacterCounterVisibility="Hidden" materialDesign:HintAssist.Hint="Eposta" Margin="{StaticResource FilterElementMargin}" Padding="{StaticResource FilterElementPadding}" />
            <ComboBox x:Name="cmbKanGrubu" Width="100" materialDesign:HintAssist.Hint="KanGrubu" Margin="{StaticResource FilterElementMargin}" Padding="{StaticResource FilterComboPadding}" />
        </StackPanel>
        
        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="2">
            <Button x:Name="btnYenile" Content="{materialDesign:PackIcon Kind=Reload, Size=28}" Style="{StaticResource MaterialDesignIconForegroundButton}" Margin="4" Click="btnYenile_Click" />
            <Button x:Name="btnSorgula" Content="{materialDesign:PackIcon Kind=Search, Size=28}" Style="{StaticResource MaterialDesignIconButton}" Margin="4" Click="btnSorgula_Click" />
        </StackPanel>
        
        <DataGrid Grid.Row="1" Grid.Column="0" SelectionMode="Extended" SelectionUnit="Cell" x:Name="dgHasta" AutoGenerateColumns="True" IsReadOnly="True" AutoGeneratingColumn="dgHasta_AutoGeneratingColumn" MaxHeight="720" Margin="20" />

        <StackPanel Grid.Row="1" Grid.Column="1" Width="200" VerticalAlignment="Bottom">
            <TextBox x:Name="txtEditId" IsEnabled="False" Margin="{StaticResource FilterElementMargin}" Padding="{StaticResource FilterElementPadding}" />
            <TextBox x:Name="txtEditKimlikNo" IsEnabled="False" MaxLength="11" PreviewTextInput="txtKimlikNo_PreviewTextInput" materialDesign:HintAssist.Hint="Kimlik No" Margin="{StaticResource FilterElementMargin}" Padding="{StaticResource FilterElementPadding}" />
            <TextBox x:Name="txtEditAd" IsEnabled="False" MaxLength="50" materialDesign:HintAssist.Hint="Ad" Margin="{StaticResource FilterElementMargin}" Padding="{StaticResource FilterElementPadding}" />
            <TextBox x:Name="txtEditSoyad" IsEnabled="False" MaxLength="50" materialDesign:HintAssist.Hint="Soyad" Margin="{StaticResource FilterElementMargin}" Padding="{StaticResource FilterElementPadding}" />
            <ComboBox x:Name="cmbEditCinsiyet" IsEnabled="False" materialDesign:HintAssist.Hint="Cinsiyet" Margin="{StaticResource FilterElementMargin}" Padding="{StaticResource FilterComboPadding}" />
            <TextBox x:Name="txtEditTelefon" IsEnabled="False" MaxLength="12" materialDesign:HintAssist.Hint="Telefon" TextChanged="txtTelefon_TextChanged" Margin="{StaticResource FilterElementMargin}" Padding="{StaticResource FilterElementPadding}" />
            <TextBox x:Name="txtEditEposta" IsEnabled="False" MaxLength="100" materialDesign:HintAssist.Hint="Eposta" Margin="{StaticResource FilterElementMargin}" Padding="{StaticResource FilterElementPadding}" />
            <ComboBox x:Name="cmbEditKanGrubu" IsEnabled="False" materialDesign:HintAssist.Hint="KanGrubu" Margin="{StaticResource FilterElementMargin}" Padding="{StaticResource FilterComboPadding}" />
            <StackPanel Orientation="Horizontal" Margin="5,20" HorizontalAlignment="Right">
                <Button x:Name="btnGuncelle" IsEnabled="False" Content="Guncelle" Width="90" Style="{StaticResource MaterialDesignRaisedDarkButton}" Margin="2,8" Click="btnGuncelle_Click" />
                <Button x:Name="btnIptal" IsEnabled="False" Content="Iptal" Width="80" Style="{StaticResource MaterialDesignRaisedSecondaryDarkButton}" Foreground="White" Margin="2,8" Click="btnIptal_Click" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>