<Page x:Class="Hastane.Views.Kayit"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Hastane.Views"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Kayit">

    <Grid>
        <!-- Header -->
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header Content -->
        <StackPanel Grid.Row="0" Margin="4" Orientation="Horizontal" Background="{StaticResource MaterialDesign.Brush.Primary.Dark}">
            <Button Content="Doktor Ekle" x:Name="btnDoktor" Width="200" Height="40" Margin="-1,-4" Style="{StaticResource MaterialDesignFlatDarkButton}" Foreground="White" Click="Doktor_Ekle" />
            <Button Content="Hasta Ekle" x:Name="btnHasta" Width="200" Height="40" Margin="-1,-4" Style="{StaticResource MaterialDesignFlatDarkButton}" Foreground="White" Click="Hasta_Ekle" />
        </StackPanel>

        <!-- Content Area -->
        <Frame Name="ContentFrame" Grid.Row="1" Margin="4,20,4,10" MaxWidth="300" />
    </Grid>
</Page>
