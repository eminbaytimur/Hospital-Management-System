<UserControl x:Class="Hastane.Views.DoktorSorgu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Hastane"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="1200">
    <UserControl.Resources>
        <local:RelativeToAbsolutePathConverter x:Key="PathConverter" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="5">
            <TextBox x:Name="txtKimlikNo" MaxLength="11" Width="100" materialDesign:TextFieldAssist.CharacterCounterVisibility="Hidden" PreviewTextInput="txtKimlikNo_PreviewTextInput" materialDesign:HintAssist.Hint="Kimlik No" Margin="{StaticResource FilterElementMargin}" Padding="{StaticResource FilterElementPadding}" />
            <TextBox x:Name="txtAd" MaxLength="50" Width="150" materialDesign:TextFieldAssist.CharacterCounterVisibility="Hidden" materialDesign:HintAssist.Hint="Ad" Margin="{StaticResource FilterElementMargin}" Padding="{StaticResource FilterElementPadding}" />
            <TextBox x:Name="txtSoyad" MaxLength="50" Width="150" materialDesign:TextFieldAssist.CharacterCounterVisibility="Hidden" materialDesign:HintAssist.Hint="Soyad" Margin="{StaticResource FilterElementMargin}" Padding="{StaticResource FilterElementPadding}" />
            <ComboBox x:Name="cmbCinsiyet" Width="80" materialDesign:HintAssist.Hint="Cinsiyet" Margin="{StaticResource FilterElementMargin}" Padding="{StaticResource FilterComboPadding}" />
            <TextBox x:Name="txtTelefon" MaxLength="12" Width="100" materialDesign:TextFieldAssist.CharacterCounterVisibility="Hidden" materialDesign:HintAssist.Hint="Telefon" TextChanged="txtTelefon_TextChanged" Margin="{StaticResource FilterElementMargin}" Padding="{StaticResource FilterElementPadding}" />
            <TextBox x:Name="txtEposta" MaxLength="100" Width="180" materialDesign:TextFieldAssist.CharacterCounterVisibility="Hidden" materialDesign:HintAssist.Hint="Eposta" Margin="{StaticResource FilterElementMargin}" Padding="{StaticResource FilterElementPadding}" />
            <ComboBox x:Name="cmbBolum" Width="180" materialDesign:HintAssist.Hint="Bolum" Margin="{StaticResource FilterElementMargin}" Padding="{StaticResource FilterComboPadding}" />
        </StackPanel>
        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="2">
            <Button x:Name="btnYenile" Content="{materialDesign:PackIcon Kind=Reload, Size=28}" Style="{StaticResource MaterialDesignIconForegroundButton}" Margin="4" Click="btnYenile_Click" />
            <Button x:Name="btnSorgula" Content="{materialDesign:PackIcon Kind=Search, Size=28}" Style="{StaticResource MaterialDesignIconButton}" Margin="4" Click="btnSorgula_Click" />
        </StackPanel>
        <DataGrid Grid.Row="1" Grid.ColumnSpan="2" x:Name="dgDoktor" AutoGenerateColumns="True" IsReadOnly="True" AutoGeneratingColumn="dgDoktor_AutoGeneratingColumn" MaxHeight="720" Margin="20">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Profil Resmi">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <Ellipse Width="64" Height="64" ClipToBounds="True">
                                    <Ellipse.Fill>
                                        <ImageBrush ImageSource="{Binding PhotoPath, Converter={StaticResource PathConverter}}"/>
                                    </Ellipse.Fill>
                                </Ellipse>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>